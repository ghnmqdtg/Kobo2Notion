{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/backend/**/*",
    "src/config/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "electron-vite/node"
    ],
    "paths": {
      "@/*": [
        "./src/renderer/src/*"
      ]
    }
  }
}