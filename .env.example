# SQLite Source (The default path is defined in MacOS)
SQLITE_SOURCE=

# Notion API Key and Data Source ID
NOTION_API=
NOTION_DB=

# Summarize Bookmarks
SUMMARIZE_ENABLED=false
SUMMARIZE_LANGUAGE=zh
LLM_PROVIDER=
LLM_MODEL=

# Per-provider API keys (only the active provider's key is used)
LLM_API_KEY_GOOGLE=
LLM_API_KEY_OPENAI=
LLM_API_KEY_ANTHROPIC=

# Appearance
THEME=light

# corsproxy.io authenticated key (optional)
# Set this to use your own quota instead of the shared rate-limited endpoint.
# Get a key at https://corsproxy.io
CORSPROXY_KEY=
